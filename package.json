{
  "name": "complianceshield-ai",
  "version": "1.0.0",
  "private": true,
  "description": "ComplianceShield AI — 기업·기관의 법정 개인정보 컴플라이언스 문서(처리방침·보호지침·내부관리계획서 등) 자동 생성/관리 B2B SaaS",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:rules": "tsx scripts/test-rules.ts",
    "test:docx": "tsx scripts/test-docx.ts",
    "test:api": "node scripts/test-api.mjs",
    "check:text": "node scripts/check-text.cjs",
    "check:catalog": "node scripts/check-catalog.cjs",
    "verify": "npm run typecheck && npm run check:text && npm run check:catalog && npm run test:rules && npm run test:docx"
  },
  "dependencies": {
    "docx": "^9.5.1",
    "lucide-react": "^0.544.0",
    "next": "15.5.4",
