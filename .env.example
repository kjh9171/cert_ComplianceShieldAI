# ============================================================
# ComplianceShield AI — 환경 변수 예시
# Vercel 배포 시 Project > Settings > Environment Variables 에서 동일하게 등록하세요.
# ============================================================

# 앱 표기용 브랜드명 (선택)
NEXT_PUBLIC_APP_NAME="ComplianceShield AI"

# ------------------------------------------------------------
# [선택] LLM 연동 — 입력하면 대화형 생성 엔진이 규칙 기반으로 자동 전환됩니다.
#        미설정 시에도 규칙 기반(로컬) 엔진으로 100% 동작합니다.
# ------------------------------------------------------------

# Anthropic Claude (권장: 긴 법률 문서 품질 우수)
ANTHROPIC_API_KEY=

# OpenAI (대안)
OPENAI_API_KEY=

# 사용할 모델명
LLM_MODEL="claude-sonnet-4-5"

# LLM 호출 허용 여부 (기본 true). LLM 비용 절약을 위해 끄면 규칙 엔진만 동작합니다.
LLM_ENABLED="true"

# ------------------------------------------------------------
# [선택] 문서 보관 서버 연동 (기본은 브라우저 localStorage 기반 MVP)
# ------------------------------------------------------------
DATABASE_URL=
AUTH_SECRET=